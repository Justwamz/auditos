{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "test": {
      "dependsOn": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": []
    },
    "lint": {
      "dependsOn": []
    }
  },
  "globalPassThroughEnv": [
    "PG_SUPERUSER_URL",
    "OWNER_PASSWORD",
    "APP_PASSWORD",
    "APP_ENC_KEY",
    "DB_NAME",
    "PG_SSL",
    "PLATFORM_ADMIN_TOKEN",
    "LOGIN_RATE_LIMIT",
    "DEV_FIXED_OTP",
    "TRUST_PROXY_HOPS",
    "UPLOAD_DIR"
  ]
}
